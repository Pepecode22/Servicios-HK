# Copia este archivo como ".env" en esta misma carpeta (server/) y completa los valores.
# Nunca subas el archivo ".env" real a un repositorio ni lo compartas por chat/email.

PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# --- Supabase ---------------------------------------------------------------
# Los encuentras en tu proyecto de Supabase: Project Settings > API
# SUPABASE_URL:               "Project URL"
# SUPABASE_SERVICE_ROLE_KEY:  "service_role" (secreta, solo se usa en el backend,
#                              nunca en el frontend)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_aqui

# --- Autenticación admin (JWT) -----------------------------------------------
JWT_SECRET=cambiar_por_una_clave_secreta_muy_larga_y_aleatoria_aqui
JWT_EXPIRES_IN=7d

# --- Cuenta admin inicial (usada solo por "npm run seed") -------------------
ADMIN_EMAIL=admin@servicioshk.cl
ADMIN_PASSWORD=Admin1234!

# --- hCaptcha (formulario de contacto) --------------------------------------
HCAPTCHA_SECRET=tu_hcaptcha_secret_key_aqui

# --- Envío de correos (SMTP) --------------------------------------------------
# Usado para: el botón "Enviar por correo" del panel admin, y el envío
# automático de notificaciones (ver NOTIFICATION_EMAIL más abajo).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=tu_correo@gmail.com
EMAIL_PASSWORD=tu_contraseña_de_aplicacion_aqui
EMAIL_FROM=Servicios HK <tu_correo@gmail.com>

# --- Notificaciones automáticas -----------------------------------------------
# Cada cotización y mensaje de contacto nuevo se envía automáticamente a esta
# dirección, además de quedar guardado y visible en el panel admin. Si se deja
# vacía, el envío automático simplemente se omite (no rompe nada).
NOTIFICATION_EMAIL=contacto@servicioshk.cl
